{
  "manifest_version": 3,
  "name": "Universal Media Downloader",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "downloads",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.xvideos.com/*",
    "*://*.alpaclass.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
