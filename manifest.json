{
  "manifest_version": 3,
  "name": "Universal Media Downloader",
  "version": "1.0",
  "description": "Baixe vídeos e áudios de qualquer plataforma suportada.",
  "permissions": [
    "activeTab",
    "cookies",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
