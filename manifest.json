{
  "manifest_version": 3,
  "name": "Universal Media Downloader",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "downloads",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.xvideos.com/*",
    "*://*.alpaclass.com/*",
    "https://baixatudo-bvx4.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN" 
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
